GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

REDIS_URL=redis://localhost:6389
DATABASE_URL=postgres://gateway:gateway@localhost:5488/llm_gateway

PORT=8787
LOG_LEVEL=info

CACHE_TTL_SECONDS=300

EMBEDDING_MODEL=gemini-embedding-001
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90

DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_TOKENS_PER_MINUTE=40000

DEFAULT_BUDGET_USD_MONTHLY=5
BUDGET_MODE=hard_stop

ADMIN_SECRET=change-me-admin-secret

ROUTING_STRATEGY=static_priority
PROVIDER_PRIORITY=groq,gemini,openrouter
