{
  "name": "llm-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-provider LLM routing gateway with fallback, caching, cost tracking, rate limiting and observability",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql');fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "lint": "eslint src test scripts --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --pool=forks --testTimeout=30000",
    "test:all": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "bench:fallback": "tsx scripts/measure-fallback.ts",
    "bench:cache": "tsx scripts/measure-cache-hitrate.ts",
    "bench:ratelimit": "tsx scripts/measure-rate-limit-concurrency.ts",
    "bench:cost": "tsx scripts/measure-cost-accuracy.ts",
    "bench:overhead": "tsx scripts/measure-overhead.ts",
    "bench:semantic-cache": "tsx scripts/measure-semantic-cache.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.1",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
